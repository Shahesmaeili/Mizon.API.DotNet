<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsAotCompatible>true</IsAotCompatible>
		<PackageId>Mizon.API</PackageId>
		<Version>1.1.6</Version>
		<Authors>AliShahesmaeili</Authors>
		<Description>Implementation of Mizon API in .NET</Description>
		<PackageTags>Mizon</PackageTags>
		<Platforms>AnyCPU;x64</Platforms>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="11.0.0" />
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="11.0.0" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0" />
	</ItemGroup>

</Project>
