<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PublishAot>true</PublishAot>
		<InvariantGlobalization>true</InvariantGlobalization>
		<StripSymbols>true</StripSymbols>
		<TrimMode>full</TrimMode>
		<PublishTrimmed>true</PublishTrimmed>
		<IlcOptimizationPreference>Speed</IlcOptimizationPreference>
		<PackageId>Mizon.API.Client</PackageId>
		<Version>1.1.6</Version>
		<Authors>AliShahesmaeili</Authors>
		<Description>Implementation of Mizon API client in .NET</Description>
		<PackageTags>Mizon, Client</PackageTags>
		<Platforms>AnyCPU;x64</Platforms>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Mizon.API\Mizon.API.csproj" />
	</ItemGroup>

</Project>
